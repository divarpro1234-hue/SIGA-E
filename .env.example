# Plantilla sin credenciales. Copiar a un archivo .env local ignorado por Git
# y completar exclusivamente fuera del repositorio cuando una etapa lo autorice.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL de la API. Mantener bases separadas para laboratorio y despliegue.
DATABASE_URL=
DIRECT_URL=

# Origen HTTPS exacto del portal interno y secretos de aplicación.
APP_ORIGIN=
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=

# Solo en producción Render, con una base administrada independiente:
# SIGAE_M1_RENDER_ENABLED=true
# M1_WRITES_ENABLED=true
# HOST=0.0.0.0
# DATABASE_URL debe incluir sslmode=require.

# M3 y AnchorWorker/M5 no se configuran en el proceso HTTP.
