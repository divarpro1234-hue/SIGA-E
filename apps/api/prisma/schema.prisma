generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  AUTHOR
  APPROVER
  ADMIN
}

enum UserStatus {
  PENDING_ENROLLMENT
  ACTIVE
  DISABLED
}

enum IdentityChallengeKind {
  ENROLLMENT
  LOGIN
  TOTP_RECONFIGURE
}

enum AlertKind {
  Alert
  Update
  Cancel
}

enum Severity {
  Extreme
  Severe
  Moderate
  Minor
  Unknown
}

enum AlertLifecycleState {
  DRAFT
  PENDING_APPROVAL
  REJECTED
  READY_TO_SIGN
  SIGNING
  SIGNED_PENDING_ANCHOR
  PUBLISHED
}

enum AnchorStatus {
  NOT_REQUESTED
  PENDING
  SUBMITTED
  CONFIRMED
  RETRYABLE_ERROR
  CONFLICT
  UNVERIFIABLE
  FAILED
  REVIEW_REQUIRED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

enum PublicKeyStatus {
  ACTIVE
  RETIRED
  REVOKED
}

enum StellarNetwork {
  TESTNET @map("testnet")
}

enum AnchorDeploymentState {
  ACTIVE
  RETIRED
  UNVERIFIABLE
}

enum AnchorJobState {
  PENDING
  LEASED
  SUBMITTED
  RETRYABLE
  CONFIRMED
  CONFLICT
  UNVERIFIABLE
  FAILED
  REVIEW_REQUIRED
}

model User {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String       @db.Text
  email                String       @unique @db.Text
  role                 UserRole
  passwordHash         String?      @map("password_hash") @db.Text
  totpSecretCiphertext Bytes?       @map("totp_secret_ciphertext") @db.ByteA
  status               UserStatus   @default(PENDING_ENROLLMENT)
  failedAttempts       Int          @default(0) @map("failed_attempts")
  lockedUntil          DateTime?    @map("locked_until") @db.Timestamptz(3)
  lastTotpStep         BigInt?      @map("last_totp_step") @db.BigInt
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions             Session[]
  authoredAlerts       Alert[]      @relation("AlertAuthor")
  approvals            Approval[]   @relation("ApprovalReviewer")
  auditEvents          AuditEvent[] @relation("AuditActor")
  identityInvitations  IdentityInvitation[] @relation("InvitationRecipient")
  issuedInvitations    IdentityInvitation[] @relation("InvitationIssuer")
  identityChallenges   IdentityChallenge[]
  initialBootstrap     IdentityBootstrap? @relation("InitialAdmin")

  @@index([status])
  @@map("users")
}

model IdentityInvitation {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  tokenHash          Bytes     @unique @map("token_hash") @db.ByteA
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(3)
  claimedAt          DateTime? @map("claimed_at") @db.Timestamptz(3)
  consumedAt         DateTime? @map("consumed_at") @db.Timestamptz(3)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(3)
  deliveryReportedAt DateTime? @map("delivery_reported_at") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  createdBy          String?   @map("created_by") @db.Uuid
  user               User      @relation("InvitationRecipient", fields: [userId], references: [id], onDelete: Restrict)
  issuer             User?     @relation("InvitationIssuer", fields: [createdBy], references: [id], onDelete: Restrict)
  challenges         IdentityChallenge[]

  @@index([userId, expiresAt])
  @@index([createdAt])
  @@map("identity_invitations")
}

model IdentityChallenge {
  id                    String                @id @default(uuid()) @db.Uuid
  userId                String                @map("user_id") @db.Uuid
  kind                  IdentityChallengeKind
  tokenHash             Bytes                 @unique @map("token_hash") @db.ByteA
  invitationId          String?               @map("invitation_id") @db.Uuid
  pendingTotpCiphertext Bytes?                @map("pending_totp_ciphertext") @db.ByteA
  expiresAt             DateTime              @map("expires_at") @db.Timestamptz(3)
  failedAttempts        Int                   @default(0) @map("failed_attempts")
  consumedAt            DateTime?             @map("consumed_at") @db.Timestamptz(3)
  revokedAt             DateTime?             @map("revoked_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  invitation            IdentityInvitation?   @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([userId, kind, expiresAt])
  @@index([expiresAt])
  @@map("identity_challenges")
}

model IdentityBootstrap {
  id             Int      @id @default(1) @db.SmallInt
  consumedAt     DateTime @map("consumed_at") @db.Timestamptz(3)
  initialAdminId String   @unique @map("initial_admin_id") @db.Uuid
  initialAdmin   User     @relation("InitialAdmin", fields: [initialAdminId], references: [id], onDelete: Restrict)

  @@map("identity_bootstrap")
}

model IdentityRateLimit {
  keyHash      Bytes     @map("key_hash") @db.ByteA
  windowStart  DateTime  @map("window_start") @db.Timestamptz(3)
  attemptCount Int       @default(0) @map("attempt_count")
  blockedUntil DateTime? @map("blocked_until") @db.Timestamptz(3)

  @@id([keyHash, windowStart])
  @@index([blockedUntil])
  @@index([windowStart])
  @@map("identity_rate_limits")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  Bytes     @unique @map("token_hash") @db.ByteA
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @map("last_seen_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model Alert {
  id                    String              @id @default(uuid()) @db.Uuid
  sender                String              @db.Text
  identifier            String              @db.Text
  sentText              String              @map("sent_text") @db.Text
  kind                  AlertKind
  severity              Severity
  lifecycleState        AlertLifecycleState @default(DRAFT) @map("lifecycle_state")
  anchorStatus          AnchorStatus        @default(NOT_REQUESTED) @map("anchor_status")
  version               Int                 @default(1)
  frozenPayload         Bytes               @map("frozen_payload") @db.ByteA
  payloadSha256         Bytes               @map("payload_sha256") @db.ByteA
  approvedPayloadSha256 Bytes?              @map("approved_payload_sha256") @db.ByteA
  jwsCompact            String?             @map("jws_compact") @db.Text
  kid                   String?             @db.Text
  messageKey            Bytes?              @unique @map("message_key") @db.ByteA
  jwsHash               Bytes?              @unique @map("jws_hash") @db.ByteA
  authorId              String              @map("author_id") @db.Uuid
  publishedAt           DateTime?           @map("published_at") @db.Timestamptz(3)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  author                User                @relation("AlertAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  signingKey            PublicKey?          @relation(fields: [kid], references: [kid], onDelete: Restrict, onUpdate: Cascade)
  references            AlertReference[]
  approvals             Approval[]
  anchorJobs            AnchorJob[]

  @@unique([sender, identifier, sentText])
  @@index([authorId, lifecycleState])
  @@index([lifecycleState, anchorStatus])
  @@index([kind, severity])
  @@map("alerts")
}

model AlertReference {
  id            String @id @default(uuid()) @db.Uuid
  alertId       String @map("alert_id") @db.Uuid
  refSender     String @map("ref_sender") @db.Text
  refIdentifier String @map("ref_identifier") @db.Text
  refSentText   String @map("ref_sent_text") @db.Text
  alert         Alert  @relation(fields: [alertId], references: [id], onDelete: Restrict)

  @@unique([alertId, refSender, refIdentifier, refSentText])
  @@index([refSender, refIdentifier, refSentText])
  @@map("alert_references")
}

model Approval {
  id         String           @id @default(uuid()) @db.Uuid
  alertId    String           @map("alert_id") @db.Uuid
  approverId String           @map("approver_id") @db.Uuid
  digest     Bytes            @db.ByteA
  decision   ApprovalDecision
  reviewedAt DateTime         @default(now()) @map("reviewed_at") @db.Timestamptz(3)
  alert      Alert            @relation(fields: [alertId], references: [id], onDelete: Restrict)
  approver   User             @relation("ApprovalReviewer", fields: [approverId], references: [id], onDelete: Restrict)

  alertVersion    Int     @map("alert_version")
  reviewedPayload Bytes   @map("reviewed_payload") @db.ByteA
  reason          String? @db.Text

  @@unique([alertId, alertVersion], map: "approvals_alert_id_alert_version_key")
  @@index([alertId, reviewedAt])
  @@index([approverId, reviewedAt])
  @@map("approvals")
}

model PublicKey {
  kid        String          @id @db.Text
  publicJwk  Json            @map("public_jwk") @db.JsonB
  thumbprint String          @unique @db.Text
  status     PublicKeyStatus @default(ACTIVE)
  validFrom  DateTime        @map("valid_from") @db.Timestamptz(3)
  retiredAt  DateTime?       @map("retired_at") @db.Timestamptz(3)
  revokedAt  DateTime?       @map("revoked_at") @db.Timestamptz(3)
  alerts     Alert[]

  @@index([status, validFrom])
  @@map("public_keys")
}

model AnchorDeployment {
  id                   String                @id @default(uuid()) @db.Uuid
  network              StellarNetwork
  networkPassphrase    String                @map("network_passphrase") @db.Text
  contractId           String                @map("contract_id") @db.Text
  wasmHash             String                @map("wasm_hash") @db.Text
  adminPublicAddress   String                @map("admin_public_address") @db.Text
  generation           Int
  state                AnchorDeploymentState @default(ACTIVE)
  deployedAt           DateTime              @map("deployed_at") @db.Timestamptz(3)
  trustedConfigVersion String                @map("trusted_config_version") @db.Text
  anchorJobs           AnchorJob[]

  @@unique([network, generation])
  @@unique([network, contractId])
  @@index([state, generation])
  @@map("anchor_deployments")
}

model AnchorJob {
  id              String           @id @default(uuid()) @db.Uuid
  alertId         String           @map("alert_id") @db.Uuid
  deploymentId    String           @map("deployment_id") @db.Uuid
  messageKey      Bytes            @map("message_key") @db.ByteA
  jwsHash         Bytes            @map("jws_hash") @db.ByteA
  state           AnchorJobState   @default(PENDING)
  txHash          String?          @map("tx_hash") @db.Text
  confirmedLedger BigInt?          @map("confirmed_ledger") @db.BigInt
  attemptCount    Int              @default(0) @map("attempt_count")
  automaticFailureCount Int        @default(0) @map("automatic_failure_count")
  nextAttemptAt   DateTime?        @map("next_attempt_at") @db.Timestamptz(3)
  leaseUntil      DateTime?        @map("lease_until") @db.Timestamptz(3)
  lastErrorCode   String?          @map("last_error_code") @db.Text
  sanitizedError  String?          @map("sanitized_error") @db.Text
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  alert           Alert            @relation(fields: [alertId], references: [id], onDelete: Restrict)
  deployment      AnchorDeployment @relation(fields: [deploymentId], references: [id], onDelete: Restrict)

  @@unique([alertId, deploymentId])
  @@unique([deploymentId, messageKey])
  @@index([state, nextAttemptAt])
  @@index([leaseUntil])
  @@index([txHash])
  @@map("anchor_jobs")
}

model AuditEvent {
  seq             BigInt   @id @db.BigInt
  occurredAt      DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorId         String?  @map("actor_id") @db.Uuid
  action          String   @db.Text
  objectType      String   @map("object_type") @db.Text
  objectId        String   @map("object_id") @db.Text
  redactedDetails Json     @map("redacted_details") @db.JsonB
  previousHash    Bytes    @map("previous_hash") @db.ByteA
  eventHash       Bytes    @map("event_hash") @db.ByteA
  actor           User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([actorId, occurredAt])
  @@index([objectType, objectId, occurredAt])
  @@map("audit_events")
}

model AuditChainState {
  id       Int    @id @default(1) @db.SmallInt
  lastSeq  BigInt @map("last_seq") @db.BigInt
  lastHash Bytes  @map("last_hash") @db.ByteA

  @@map("audit_chain_state")
}
