{
  "name": "@siga-e/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cliente React/PWA original integrado de SIGA-E.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter @siga-e/verify build && tsc --noEmit && vite build && node tools/generar-sw.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.mjs\""
  },
  "dependencies": {
    "@siga-e/verify": "workspace:*",
    "qrcode.react": "4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
